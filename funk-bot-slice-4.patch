 .avatar img{width:100%;height:100%;object-fit:contain;overflow:hidden;border-radius:inherit}.character-reveal{text-align:center}.character-reveal .reveal-art{width:200px;height:200px;margin:10px auto 18px;display:grid;place-items:center;animation:reveal-pop .55s ease-out}.reveal-art img{width:100%;height:100%;object-fit:contain}.character-reveal h2{font-size:27px;margin:0;letter-spacing:-.04em}.character-reveal p:not(.eyebrow){color:#aaa8af;line-height:1.6}.character-reveal .primary{margin-top:20px}.rarity-label{display:inline-block;color:#d4bfff;border:1px solid #554466;border-radius:20px;padding:5px 11px;font-size:10px;text-transform:uppercase;letter-spacing:.1em}@keyframes reveal-pop{from{opacity:0;transform:scale(.84) rotateY(30deg)}to{opacity:1;transform:scale(1) rotateY(0)}}
 .workspace-tabs{display:flex;gap:3px;padding:4px;margin-top:24px;background:#202022;border:1px solid #303033;border-radius:9px}.workspace-tabs button{flex:1;padding:8px;background:transparent;color:#aaa8af;border-radius:6px;font-size:11px;font-weight:650}.workspace-tabs button.active{background:#39323f;color:#eadfff}.workspace-tabs+.search{margin-top:16px}.office-view{height:100%;min-height:0;display:flex;flex-direction:column}.office-header{height:75px;flex-shrink:0;display:flex;align-items:center;gap:11px;padding:0 35px;border-bottom:1px solid #28282a;background:#131314}.office-header>div{display:flex;flex-direction:column;gap:4px;flex:1}.office-header strong{font-size:13px}.office-header span{font-size:11px;color:#8f8d94}.office-content{overflow:auto;min-height:0;padding:45px 40px 60px;width:100%;max-width:1300px;margin:0 auto}.office-title{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:26px}.office-title h1{font-size:32px;letter-spacing:-.05em;margin:0}.office-title p:last-child{color:#aaa8af;font-size:12px;line-height:1.6}.office-badge{display:flex;align-items:center;gap:6px;color:#cdb9ec;background:#30283b;border:1px solid #483c54;border-radius:20px;padding:7px 10px;font-size:10px}.office-grid{display:grid;grid-template-columns:minmax(0,1fr) 245px;gap:14px}.office-scene,.office-activity{background:#1b1b1d;border:1px solid #353238;border-radius:14px;overflow:hidden}.office-scene canvas{display:block;width:100%;height:auto;image-rendering:pixelated;cursor:pointer}.office-scene-footer{display:flex;justify-content:space-between;gap:10px;padding:14px;color:#88858d;font-size:10px}.office-scene-footer span:first-child{color:#af9bc8;letter-spacing:.1em;font-weight:700}.office-activity{padding:18px}.office-activity-head{display:flex;align-items:center;justify-content:space-between}.office-activity-head strong{font-size:14px}.office-activity-head .eyebrow{font-size:9px!important;margin-bottom:8px!important}.office-events{margin-top:20px;max-height:400px;overflow:auto}.office-event{display:flex;gap:9px;padding:0 0 15px}.office-event>span{width:6px;height:6px;background:#b6a0dc;border-radius:50%;flex-shrink:0;margin-top:6px}.office-event p{margin:0;color:#cbc9ce;font-size:11px;line-height:1.5;overflow-wrap:anywhere}.office-event small{display:block;margin-top:4px;color:#78757e;font-size:10px}.office-accessible{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:20px}.office-accessible strong{font-size:11px;color:#a7a3ab;margin-right:5px}.office-accessible button{display:inline-flex;align-items:center;gap:5px;border:1px solid #403b45;border-radius:8px;padding:8px;background:#242226;color:#d9cfdf;font-size:11px}@media(max-width:900px){.office-grid{grid-template-columns:1fr}.office-events{max-height:220px}}@media(max-width:700px){.office-header{height:67px;padding:0 18px}.office-content{padding:28px 16px 45px}.office-title h1{font-size:25px}.office-title p:last-child{font-size:11px}.office-scene-footer{font-size:9px}.office-activity{padding:16px}}
