diff --git a/frontend/app/globals.css b/frontend/app/globals.css
index d11f4ae..ec38d4b 100644
--- a/frontend/app/globals.css
+++ b/frontend/app/globals.css
@@ -19,3 +19,7 @@
 .gallery-row .bot-card{min-height:0}.bot-card-art{min-height:0}.bot-card-art img{min-height:0}.office-paging{display:flex;align-items:center;gap:8px;color:#c7bad1;font-size:11px}.office-paging button{padding:6px 8px}
 .bot-card.selected{border-color:#f3cc71;box-shadow:0 0 12px #f3b95366,0 0 15px #b636dd66}.quick-mission label{max-width:210px;overflow:hidden;text-overflow:ellipsis}
 .gallery-row.cluster{grid-template-rows:18px minmax(0,1fr);row-gap:6px}.cluster-heading{grid-column:1/-1;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#e6c37c;font-weight:750}
+/* Keep both name and job visible, even for long custom titles. */
+.bot-card-details{height:auto;min-height:54px;overflow:visible;flex-shrink:0}.bot-card-art{flex:1;height:auto}.bot-card-details strong,.bot-card-details span,.bot-card-details small{white-space:normal;overflow:visible;text-overflow:clip;overflow-wrap:anywhere}.gallery-row.list .bot-card-details{height:auto;align-self:center}.spotlight-actions{display:flex;gap:8px;padding:8px 16px;border-bottom:1px solid #553456}.spotlight-profile small{color:#c2aacd}.sprite-options{display:flex;flex-direction:column;gap:12px}.sprite-options label{display:flex;align-items:center;gap:10px;line-height:1.5}.sprite-options input{width:auto}.header-identity strong,.header-identity span,.bot-name,.bot-title{white-space:normal;overflow-wrap:anywhere}.chat-header{min-height:76px;height:auto}.collection-members button{overflow-wrap:anywhere}
+.overlay{z-index:60}.quick-mission label{max-width:none;white-space:normal;overflow:visible;text-overflow:clip;overflow-wrap:anywhere}
+.spotlight-profile>div,.header-identity{min-width:0;overflow-wrap:anywhere}.spotlight-profile h2,.spotlight-profile p,.spotlight-profile small{overflow-wrap:anywhere}
