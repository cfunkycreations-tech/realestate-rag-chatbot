-:root{color-scheme:dark;--bg:#111112;--panel:#181819;--surface:#202022;--surface2:#262628;--border:#303033;--muted:#99989e;--text:#f3f2f0;--accent:#b9a0fa;--accent2:#d8cafa}*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text);font-size:14px}button,input,textarea,select{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.5}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid #cbb6ff;outline-offset:3px}button{border:0;color:inherit}input,textarea,select{color:var(--text);background:#1c1c1e;border:1px solid #353538;border-radius:9px;padding:11px 12px;outline:none}input:focus,textarea:focus,select:focus{border-color:#8e75ce}textarea{resize:vertical}a{color:var(--accent)}.app-shell{height:100dvh;display:flex;overflow:hidden}.sidebar{width:280px;flex-shrink:0;background:#171718;border-right:1px solid #2a2a2c;display:flex;flex-direction:column;padding:27px 16px 14px}.sidebar-top{padding:0 8px;display:flex;justify-content:space-between;align-items:center}.brand{display:flex;align-items:center;gap:9px;font-size:19px;font-weight:750;letter-spacing:-1px}.brand-dot{color:#bba1fb}.brand-mark{width:27px;height:27px;display:grid;place-items:center;background:#c5aff8;color:#20172d;border-radius:8px;font-size:21px;line-height:1}.brand-mark span{transform:rotate(12deg)}.workspace-badge{font-size:8px;letter-spacing:.09em;color:#76757a;font-weight:700}.search{height:40px;border:1px solid #303032;background:#1d1d1f;border-radius:9px;margin-top:35px;display:flex;align-items:center;gap:9px;padding:0 10px;color:#85848a}.search input{border:0;outline:0;background:none;padding:0;min-width:0;flex:1;font-size:12px}.search kbd{font-family:inherit;font-size:10px;border:1px solid #3b3b3e;border-radius:4px;padding:2px 4px;color:#77767d}.sidebar-section{margin-top:31px}.section-label{display:flex;align-items:center;justify-content:space-between;padding:0 7px 9px;color:#85848a;font-size:10px;letter-spacing:.09em;font-weight:750}.count{font-size:10px;color:#69686d;margin-left:4px}.icon-btn{background:transparent;display:inline-flex;align-items:center;justify-content:center;border-radius:7px;padding:6px;color:#aaa9ae}.icon-btn:hover,.settings-button:hover{background:#2a292d;color:white}.bot-list{display:flex;flex-direction:column;gap:5px}.bot-row{width:100%;text-align:left;display:flex;align-items:center;gap:11px;background:transparent;border:1px solid transparent;border-radius:10px;padding:11px 9px;min-width:0}.bot-row:hover{background:#222224}.bot-row.active{background:#29262e;border-color:#393441}.bot-row-copy{min-width:0;display:flex;flex-direction:column;gap:3px;flex:1}.bot-name{font-size:13px;font-weight:650}.bot-title{font-size:11px;color:#aaa8af}.bot-latest{font-size:11px;color:#77767e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.selected-dot{width:6px;height:6px;border-radius:50%;background:#bda5f3;flex-shrink:0}.avatar{display:inline-grid;place-items:center;position:relative;flex-shrink:0;width:40px;height:40px;border-radius:50%;color:#292334;box-shadow:inset 0 -3px 0 #0000000d}.avatar.small{width:34px;height:34px}.avatar.large{width:76px;height:76px}.avatar.square{border-radius:13px}.avatar.cloud{border-radius:40% 50% 44% 49%}.avatar.lavender,.swatch.lavender{background:#c6b0ed}.avatar.peach,.swatch.peach{background:#f3b9a2}.avatar.mint,.swatch.mint{background:#a8d7bd}.avatar.blue,.swatch.blue{background:#a9c7e7}.avatar.yellow,.swatch.yellow{background:#e8d59c}.avatar-face{display:flex;align-items:center;gap:5px;transform:translateY(1px)}.avatar-face i{display:block;width:3px;height:5px;background:#302938;border-radius:50%}.avatar.large .avatar-face{gap:9px}.avatar.large .avatar-face i{width:5px;height:8px}.avatar.working .avatar-face{animation:look 1.7s ease-in-out infinite}@keyframes look{0%,100%{transform:translate(0,1px)}50%{tr