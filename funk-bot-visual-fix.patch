+/* Shared Command Center tokens: sidebar, cards, navigation, and canvas. */
+:root{
+  --command-ink:#f8eaff;--command-muted:#c5add3;--command-bg:#0c0714;
+  --command-panel:#171022;--command-panel-raised:#241332;--command-panel-hover:#382044;
+  --command-frame:#c69a50;--command-frame-bright:#f3cc71;
+  --command-purple:#c45bff;--command-grid:#392247;--command-room:#281635;
+  --command-radius:13px;--command-radius-small:9px;
+  --command-glow:0 0 18px #ce50ff99,0 0 8px #e2b14a88;
+  --command-selected:0 0 12px #f3b95366,0 0 15px #b636dd66;
+  --command-divider:#604173;
+}
+.command-banner{background-color:var(--command-panel);border-color:var(--command-frame)}
+.command-nav{background:var(--command-bg);border-color:var(--command-frame)}
+.command-nav button{background:var(--command-panel);border-color:var(--command-frame);border-radius:var(--command-radius-small)}
+.gallery-panel,.team-panel{background:var(--command-panel);border-color:var(--command-frame);border-radius:var(--command-radius)}
+.bot-card{background:var(--command-panel);border-color:var(--command-frame);border-radius:var(--command-radius)}
+.bot-card:hover{box-shadow:var(--command-glow)}
+.bot-card.selected{border-color:var(--command-frame-bright);box-shadow:var(--command-selected)}
+.bot-card-art .avatar{width:76px;height:76px;border:2px solid var(--command-frame);box-shadow:var(--command-selected)}
+.command-center{color:var(--command-ink)}
+.sidebar{width:280px;flex-shrink:0;height:100dvh;display:flex;flex-direction:column;min-height:0;padding:22px 14px 12px;background:linear-gradient(180deg,var(--command-panel-raised),var(--command-bg));border-right:2px solid var(--command-frame);box-shadow:2px 0 16px #7b2bd044;color:var(--command-ink)}
+.sidebar-top{display:flex;align-items:center;justify-content:space-between;padding:0 7px;flex-shrink:0}
+.workspace-badge{padding:6px 8px 0;color:var(--command-muted);font-size:9px;letter-spacing:.15em;font-weight:750}
+.sidebar .brand-mark{color:var(--command-bg);background:var(--command-frame-bright);box-shadow:var(--command-selected)}
+.sidebar .brand-dot{color:var(--command-purple)}
+.drawer-close,.drawer-backdrop{display:none}
+.sidebar .icon-btn{color:var(--command-muted)}.sidebar .icon-btn:hover{color:var(--command-ink);background:var(--command-panel-hover);box-shadow:var(--command-glow)}
+.search{height:42px;display:flex;align-items:center;gap:9px;flex-shrink:0;margin:20px 0 0;padding:0 11px;background:var(--command-bg);border:1px solid var(--command-frame);border-radius:var(--command-radius-small);color:var(--command-muted)}
+.search:focus-within{border-color:var(--command-frame-bright);box-shadow:var(--command-selected)}
+.search input{min-width:0;flex:1;background:transparent;border:0;padding:0;outline:0;color:var(--command-ink);font-size:12px}
+.sidebar-section{display:flex;flex-direction:column;flex:1;min-height:0;margin-top:22px}
+.section-label{display:flex;justify-content:space-between;align-items:center;flex-shrink:0;padding:0 6px 10px;color:var(--command-muted);font-size:10px;font-weight:750;letter-spacing:.12em}
+.count{color:var(--command-frame-bright);margin-left:5px;font-size:11px}
+.bot-list{display:flex;flex-direction:column;gap:7px;min-height:0;flex:1;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:var(--command-frame) var(--command-bg);padding:2px 3px 8px}
+.collection-all,.collection-entry{display:flex;align-items:center;width:100%;border:1px solid var(--command-frame);border-radius:var(--command-radius-small);background:var(--command-panel)}
+.collection-all{justify-content:space-between;padding:9px 11px;color:var(--command-ink);font-size:11px;font-weight:700;text-align:left}
+.collection-all:hover,.collection-entry:hover{box-shadow:var(--command-glow);border-color:var(--command-frame-bright)}
+.collection-all span:last-child,.collection-filter span:last-child{color:var(--command-frame-bright);margin-left:auto}
+.collection-group{flex-shrink:0;min-width:0}.collection-filter{min-width:0;flex:1;display:flex;gap:7px;align-items:center;padding:9px 10px;text-align:left;background:transparent;color:var(--command-ink);font-size:11px;font-weight:700}.collection-filter span:first-child{overflow-wrap:anywhere}
+.collection-toggle{display:grid;place-items:center;width:32px;align-self:stretch;background:transparent;color:var(--command-frame-bright)}.collection-toggle[aria-expanded="true"] svg{transform:rotate(90deg)}
+.collection-selected{background:var(--command-panel-hover)!important;box-shadow:inset 0 0 0 1px var(--command-frame-bright)}
+.collection-members{display:flex;flex-direction:column;gap:6px;padding:7px 0 0 9px}
+.bot-row{width:100%;min-width:0;flex-shrink:0;display:flex;align-items:center;gap:10px;text-align:left;padding:7px;background:var(--command-panel);border:1px solid var(--command-frame);border-radius:var(--command-radius);color:var(--command-ink);transition:transform .2s,box-shadow .2s,border-color .2s}
+.bot-row:hover{transform:translateY(-2px);border-color:var(--command-frame-bright);box-shadow:var(--command-glow)}
+.bot-row.active{border-color:var(--command-frame-bright);box-shadow:var(--command-selected);background:var(--command-panel-raised)}
+.bot-row .avatar{width:50px;height:50px;border:2px solid var(--command-frame);border-radius:var(--command-radius-small);background-color:var(--command-panel-raised);overflow:hidden}
+.bot-row-copy{display:flex;flex-direction:column;gap:4px;min-width:0;flex:1}.bot-name{font-size:12px;font-weight:750;line-height:1.25;overflow-wrap:anywhere}.bot-title{color:var(--command-muted);font-size:11px;line-height:1.3;overflow-wrap:anywhere}.bot-name .real-state{margin-right:5px}
+.roster-empty{color:var(--command-muted);font-size:12px;line-height:1.6;padding:0 8px}
+.add-bot{flex-shrink:0;display:flex;align-items:center;justify-content:center;gap:8px;margin:10px 0;padding:9px;border:1px solid var(--command-frame);border-radius:var(--command-radius-small);background:var(--command-panel-raised);color:var(--command-ink);font-size:12px;font-weight:750}
+.add-bot:hover{border-color:var(--command-frame-bright);box-shadow:var(--command-glow)}
+.sidebar-bottom{flex-shrink:0;border-top:1px solid var(--command-divider);padding-top:7px}
+.settings-button{width:100%;display:flex;align-items:center;gap:10px;padding:10px;background:transparent;border-radius:var(--command-radius-small);color:var(--command-ink);text-align:left;font-size:12px}.settings-button span{flex:1}.settings-button:hover{background:var(--command-panel-hover);box-shadow:var(--command-glow)}
+.account{display:flex;gap:10px;align-items:center;border-top:1px solid var(--command-divider);padding:12px 7px 2px}.account-avatar{width:32px;height:32px;display:grid;place-items:center;flex-shrink:0;border:1px solid var(--command-frame);border-radius:50%;background:var(--command-panel-raised);color:var(--command-ink);font-weight:750}.account div:nth-child(2){display:flex;flex:1;flex-direction:column;gap:3px}.account strong{font-size:12px}.account small,.account-dots{color:var(--command-muted);font-size:10px}
+.office-view{background:var(--command-bg);color:var(--command-ink)}.office-header{background:var(--command-panel);border-color:var(--command-frame)}.office-header span,.office-title p,.office-event p,.office-event small{color:var(--command-muted)}.office-scene,.office-activity{background:var(--command-panel);border:1px solid var(--command-frame);border-radius:var(--command-radius);box-shadow:var(--command-selected)}.office-scene-footer{background:var(--command-panel-raised);border-color:var(--command-divider);color:var(--command-muted)}.office-canvas-scroll{background:var(--command-bg);scrollbar-color:var(--command-frame) var(--command-bg)}.office-badge,.office-accessible button{background:var(--command-panel-raised);border-color:var(--command-frame);color:var(--command-ink)}.office-accessible button:hover{box-shadow:var(--command-glow)}
