# Optional: set to a stable random value (at least 32 characters) for signed sessions.
# If unset, a random key is generated and kept in the data volume.
# Setting this disables automatic workspace restore to ensure old sessions are invalidated.
# FUNK_SESSION_SECRET=
# Internal URL used by the backend container to reach OmniRoute.
OMNIROUTE_URL=http://omniroute:20128/v1

# Optional: override the data root, or manually select a staged restore.
# The normal workspace remains at /data; never run two backends on one directory.
# FUNK_DATA_DIR=/data/restores/<stage-id>

# Optional offline disposable shell. Also start with: docker compose --profile computer up --build
# FUNK_COMPUTER_ENABLED=1

# Optional live desktop view and owner input for active commands (experimental, offline).
# Requires the computer profile and per-Bot permission; rebuild the worker image.
# FUNK_COMPUTER_DESKTOP_ENABLED=1

# Optional HTTPS browser egress broker; exact hosts require owner allowlisting
# and a separate approved open_url action in each Bot session.
# FUNK_COMPUTER_BROWSER_NETWORK=1
